APP_NAME=Personal a Honorarios
APP_URL=http://localhost/honorarios

AUTH_MODE=local
LOCAL_AUTH_ENABLED=true
LOCAL_AUTH_ADMIN_USERNAME=admin
LOCAL_AUTH_ADMIN_PASSWORD=admin123
LOCAL_AUTH_RRHH_USERNAME=rrhh
LOCAL_AUTH_RRHH_PASSWORD=rrhh123
LOCAL_AUTH_FINANZAS_USERNAME=finanzas
LOCAL_AUTH_FINANZAS_PASSWORD=finanzas123
LOCAL_AUTH_HONORARIO_USERNAME=honorario
LOCAL_AUTH_HONORARIO_PASSWORD=honorario123

CU_CLIENT_ID=
CU_CLIENT_SECRET=
CU_REDIRECT_URI=https://app.muniloslagos.cl/sgh/auth/callback

# Endpoints oficiales de ClaveUnica (ajusta si tu institucion usa otros)
CU_AUTH_URL=https://accounts.claveunica.gob.cl/openid/authorize/
CU_TOKEN_URL=https://accounts.claveunica.gob.cl/openid/token/
CU_USERINFO_URL=https://accounts.claveunica.gob.cl/openid/userinfo/

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=appmuniloslagos_sgh
DB_USER=appmuniloslagos_sgh
DB_PASS=

# Lista RUN permitidos para el perfil HONORARIO (separados por coma, sin puntos)
# Ejemplo: 12345678-9,11111111-1
HONORARIO_RUN_WHITELIST=
